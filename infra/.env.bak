# pseint-judge — local stack environment (todo 36).
#
# LOCAL-FIRST: copy this to `infra/.env` (gitignored) and `docker compose up
# -d` from the `infra/` directory.  Plain HTTP at http://localhost once
# DOMAIN is left UNSET below.
#
# Never commit `infra/.env` — it holds your real ADMIN_PASSWORD and
# SECRET_KEY.  Only `infra/.env.example` is version-controlled.

# ─── Postgres ───────────────────────────────────────────────────────────────
# These match the postgres service in docker-compose.yml.  The compose file
# falls back to `pseint` for both when unset (LOCAL convenience); change
# them for any non-toy deployment.
POSTGRES_USER=pseint
POSTGRES_PASSWORD=pseint
POSTGRES_DB=pseint
# Host-side port forwarded to the container's 5432.  Bind to 127.0.0.1 for
# localhost-only access; use 0.0.0.0:5432 if you need psql from another
# machine (NOT recommended on a public host).
POSTGRES_HOST_PORT=127.0.0.1:5432:5432

# ─── API secrets ────────────────────────────────────────────────────────────
# SECRET_KEY is required (compose will refuse to start without it).  Must
# be at least 32 chars; the API's config.py refuses to boot otherwise.
# Generate one locally with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-me-with-a-random-string-of-at-least-32-chars

# ADMIN_USERNAME + ADMIN_PASSWORD are read by `alembic upgrade head` (via
# pseint_api.bootstrap.bootstrap_admin) on first migrate; if both are set,
# an admin user is created with these credentials.  The compose stack does
# NOT run migrations automatically — see README.md + OPS.md (todo 41).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=5610

# ─── CORS ───────────────────────────────────────────────────────────────────
# Comma-separated allowlist for browser origins that may call the API
# cross-origin.  Default empty = same-origin only.  Set this when the API
# and frontend are on different origins (UNAM production behind a CDN).
# Example:  CORS_ALLOW_ORIGINS=https://judge.example.unam.mx
CORS_ALLOW_ORIGINS=

# ─── Worker pool ────────────────────────────────────────────────────────────
# REPLICAS drives the in-process RQ worker count inside the worker
# container (infra/worker/worker.py:worker_count()).  Default 3 matches
# the plan's "3 stateless workers" baseline.  Bump for burst tolerance.
REPLICAS=3

# WORKER_IMAGE is the engine sandbox image the wrapper spawns per
# submission (todo 34).  It must match the tag the engine sandbox image
# was built with (`docker build -f infra/Dockerfile.worker ...`).
WORKER_IMAGE=pseint-judge-worker:latest

# ─── Logging ────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
TOKEN_TTL_MINUTES=1440

# ─── Caddy / TLS ────────────────────────────────────────────────────────────
# DOMAIN unset → HTTP localhost mode (LOCAL-FIRST default).
# DOMAIN set  → Caddy serves HTTPS on the matching host with auto-renewed
#               certs (production / UNAM host — todo 40).  Set to e.g.
#               "judge.example.unam.mx" to enable.
DOMAIN=

# Host-side ports for Caddy.  80 is required; 443 is only opened when
# DOMAIN is set (UNAM).  Change if you already have something on 80/443.
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# ─── Local-only overrides ───────────────────────────────────────────────────
# Optional: bind the postgres port to 0.0.0.0 if you need external psql
# access during development (NEVER do this on a public host).
# POSTGRES_HOST_PORT=0.0.0.0:5432:5432
#
# Optional: expose redis on the host for the rq-dashboard debug tool.
# NEVER do this on a public host.
# REDIS_HOST_PORT=127.0.0.1:6379:6379SECRET_KEY=_wC37JLDzad7F8mWL27XjFllm5DHDbGc6ZJtn3XM1M7VBWOfAOGvpoWbrjNshHRW
ADMIN_PASSWORD=5610
