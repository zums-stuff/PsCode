# pseint-judge — Caddy reverse proxy (todo 36).
#
# LOCAL-FIRST: when DOMAIN is unset (the default), Caddy binds to plain
# HTTP on :80 and serves everything from the static frontend + proxies
# /api/* to the api container.  This is the LOCAL mode used for every
# plan acceptance check (todo 36 + 37 + 40 + 42).
#
# When DOMAIN is set (e.g. "judge.example.unam.mx"), Caddy activates
# auto-HTTPS via Let's Encrypt (ACME http-01 challenge on :80, real cert
# served on :443).  Caddy handles cert renewal automatically.  This mode
# is exercised only on the UNAM production host (post-plan, todo 40).
#
# Security headers are applied to ALL responses (LOCAL + production):
#   * X-Frame-Options DENY          — clickjacking
#   * X-Content-Type-Options nosniff — MIME sniffing
#   * Referrer-Policy no-referrer   — privacy
# The SPA frontend is a single-page app; no embedding context needed.
#
# CORS: cross-origin browser requests to /api/* are blocked unless
# CORS_ALLOW_ORIGINS is set in the API's env (the API applies the
# allowlist).  Caddy does NOT inject CORS headers — the API owns them.

# ─── Site block ─────────────────────────────────────────────────────────────
# LOCAL-FIRST rule (plan §Success Criteria): the LOCAL smoke probe must reach
# http://localhost/healthz on a fresh clone with DOMAIN unset.  We use
# Caddy's :80 listen-address as the site block unconditionally — it works
# for both LOCAL (no DOMAIN) and production-with-extra-DOMAIN setups.
# When DOMAIN is set, the second site block below auto-provisions TLS for
# that hostname (Let's Encrypt via ACME http-01).  In LOCAL mode (no DOMAIN
# env), only this :80 block runs and TLS is skipped entirely.
:80 {
    # Reverse-proxy the API.  The api service is on the compose internal
    # network at api:8000 (uvicorn).  ``header_up`` strips the inbound
    # Host so the API doesn't see the wrong virtual host; ``header_down``
    # is left default so API-set headers (CORS) flow through unchanged.
    reverse_proxy /api/* api:8000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
        # Per-route health: a failed API is removed from the pool until it
        # recovers (the API's own /healthz must return 200).
        health_uri /healthz
        health_interval 10s
        health_timeout 5s
    }

    # Liveness + readiness probes — Caddy serves these directly from the
    # API without rate limiting (the API's RateLimitMiddleware skips
    # /healthz and /readyz prefixes).  Useful for ops dashboards.
    reverse_proxy /healthz api:8000
    reverse_proxy /readyz api:8000

    # WebSocket endpoint for live submission results (todo 19).  The
    # ``/ws/*`` path is matched first so the SPA's per-route fallback
    # below doesn't intercept it.
    reverse_proxy /ws/* api:8000 {
        header_up Host {host}
    }

    # Static frontend — SPA mounted at /srv/frontend in the caddy
    # container (volume from the frontend service).  ``file_server`` is
    # the Caddy built-in static server with a sane default set of
    # content-types and ETag/If-Modified-Since handling.
    root * /srv/frontend
    encode zstd gzip
    file_server

    # SPA fallback: unknown paths return index.html so client-side
    # routes (/problems, /problem/:id, /contest/:id, /submissions,
    # /admin/*, etc.) work on hard reload.  CRITICAL: the exclude list
    # must contain every path that file_server serves as a real file —
    # most importantly the Vite-hashed ``/assets/*`` JS/CSS bundles.  If
    # ``/assets/*`` is rewritten to index.html, the browser receives HTML
    # where it expects JS and the app silently fails to boot (blank page).
    @spa_fallback not path /api/* /ws/* /healthz /readyz /assets/*
    rewrite @spa_fallback /index.html

    # Security headers — applied to every response (including /api/*).
    # The first three are unconditional (LOCAL + production); HSTS is
    # scoped to the @https matcher so it is only emitted when DOMAIN is
    # set and Caddy terminates TLS.  In LOCAL mode (HTTP) the header is
    # absent, so a misconfigured DOMAIN cannot brick dev.
    header {
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        # Don't leak the server identity.
        -Server
    }

    # HSTS (todo 40 / OPS.md §10) — only emitted when this site block is
    # answering HTTPS.  ``max-age=31536000`` (1 year), ``includeSubDomains``
    # for any future sibling hosts, ``preload`` opt-in (operator can submit
    # the domain to hstspreload.org after confirming every subdomain
    # serves HTTPS).
    @https protocol https
    header @https Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

    # Access log — Caddy emits structured JSON to stdout; the compose
    # stack captures it via the standard docker logs mechanism.
    log
}

# ─── Production (UNAM) site block — UNCOMMENT after setting DOMAIN ────────
# When deploying to the UNAM production host:
#   1. Set ``DOMAIN=judge.example.unam.mx`` in ``infra/.env``.
#   2. Open the firewall: ``ufw allow 80/tcp 443/tcp`` (port 80 for the
#      ACME http-01 challenge, 443 for live HTTPS).
#   3. Uncomment the block below.  Caddy auto-provisions a Let's Encrypt
#      cert on first request and rotates it automatically.
#
# :443 {
#     tls {
#         protocols tls1.2 tls1.3
#     }
#     reverse_proxy /api/* api:8000 { ... }
#     # ... same body as the :80 block above, but with TLS termination
# }